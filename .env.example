# ==============================================================================
# Second Opinion - Environment Configuration
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file or API keys to version control.
# ==============================================================================

# Google Gemini API key (Free tier available at https://aistudio.google.com/)
# If left blank, Second Opinion runs in offline demo mode using realistic sample datasets.
GEMINI_API_KEY=your_gemini_api_key_here

# Target Gemini model (default: gemini-2.5-flash or gemini-3.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Local response caching to conserve free-tier API quota ("on" or "off")
LLM_CACHE=on
