# ==============================================================================
# Second Opinion - Environment Configuration
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file or API keys to version control.
# ==============================================================================

# Google Gemini API key(s) (Free tier available at https://aistudio.google.com/)
# Provide a single key:
GEMINI_API_KEY=your_gemini_api_key_here
# Or provide multiple comma-separated keys for automatic quota (429) rotation:
GEMINI_API_KEYS=your_gemini_api_key_1_here,your_gemini_api_key_2_here

# Target Gemini model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Fallback Gemini model for transient 503 / unavailable failover (default: gemini-3.7-flash)
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# Local response caching to conserve free-tier API quota ("on" or "off")
LLM_CACHE=on

# Document Upload & Extraction Limits
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=100

